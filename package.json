{
  "name": "yongin-day",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "preview": "vite preview",
    "test": "playwright test",
    "build:site": "npm run build && node scripts/build-worker.mjs",
    "test:server": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/gugi": "^5.3.0",
    "@fontsource/noto-emoji": "^5.3.2",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "leaflet": "^1.9.4",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
