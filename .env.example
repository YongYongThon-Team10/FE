# 비워 두면 Figma 시연 데이터 모드입니다. 실제 API 규격은 docs/API_CONTRACT.md 참고.
VITE_API_BASE_URL=
# 서버 데이터 재조회 주기 (밀리초, 최소 15000). n8n은 서버 DB를 갱신합니다.
VITE_DATA_REFRESH_MS=60000
# 카카오 지도 JavaScript 키. 등록한 도메인에서만 사용할 수 있습니다.
VITE_KAKAO_JAVASCRIPT_KEY=
# REST API 키는 프론트에 넣지 않습니다. 서버 비밀설정: KAKAO_REST_API_KEY
# 실제 장소 검색 서버. 비워 두면 기존 Figma 시연 화면을 사용합니다.
VITE_PLACES_API_BASE=
